[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/stage_select.gd" id="1_menu"]
[ext_resource type="Script" path="res://scripts/stage_backdrop.gd" id="2_stars"]
[ext_resource type="Theme" path="res://assets/ui/menu-theme.tres" id="3_theme"]

[node name="StageSelect" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("3_theme")
script = ExtResource("1_menu")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.018, 0.027, 0.075, 1)

[node name="Starfield" type="Node2D" parent="."]
script = ExtResource("2_stars")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 64
theme_override_constants/margin_top = 64
theme_override_constants/margin_right = 64
theme_override_constants/margin_bottom = 48

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="GameTitle" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 0.95, 1, 1)
theme_override_font_sizes/font_size = 20
text = "忍者ぶっとびくん Galaxy"

[node name="Title" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 42
text = "ステージ選択"

[node name="Description" type="Label" parent="Margin/Content"]
layout_mode = 2
text = "チュートリアルで練習して、星のぼり・暴風の峡谷・追跡者に挑戦しよう。"

[node name="Stages" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 16
alignment = 1

[node name="Stage1" type="Button" parent="Margin/Content/Stages"]
focus_neighbor_top = NodePath("../../../../ReturnTitle")
focus_neighbor_right = NodePath("../Stage2")
focus_neighbor_left = NodePath("../Stage1")
focus_neighbor_bottom = NodePath("../../Preview")
custom_minimum_size = Vector2(172, 232)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
text = "ステージ 1\n\nチュートリアル\n\nプレイする"

[node name="Stage2" type="Button" parent="Margin/Content/Stages"]
focus_neighbor_top = NodePath("../../../../ReturnTitle")
focus_neighbor_right = NodePath("../Stage3")
focus_neighbor_left = NodePath("../Stage1")
focus_neighbor_bottom = NodePath("../../Preview")
custom_minimum_size = Vector2(172, 232)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
text = "ステージ 2\n\n星のぼりの塔\n\nプレイする"

[node name="Stage3" type="Button" parent="Margin/Content/Stages"]
focus_neighbor_top = NodePath("../../../../ReturnTitle")
custom_minimum_size = Vector2(172, 232)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
focus_neighbor_left = NodePath("../Stage2")
focus_neighbor_right = NodePath("../Stage4")
focus_neighbor_bottom = NodePath("../../Preview")
text = "ステージ 3\n\n壁キックと重力\n\nプレイする"

[node name="Stage4" type="Button" parent="Margin/Content/Stages"]
focus_neighbor_top = NodePath("../../../../ReturnTitle")
custom_minimum_size = Vector2(172, 232)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
focus_neighbor_left = NodePath("../Stage3")
focus_neighbor_right = NodePath("../Stage5")
focus_neighbor_bottom = NodePath("../../Preview")
text = "ステージ 4\n\n星渡りの回廊\n\nプレイする"

[node name="Stage5" type="Button" parent="Margin/Content/Stages"]
focus_neighbor_top = NodePath("../../../../ReturnTitle")
custom_minimum_size = Vector2(172, 232)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
focus_neighbor_left = NodePath("../Stage4")
focus_neighbor_right = NodePath("../Stage6")
focus_neighbor_bottom = NodePath("../../Preview")
text = "ステージ 5\n\n暴風バンパー峡谷\n\nプレイする"

[node name="Stage6" type="Button" parent="Margin/Content/Stages"]
focus_neighbor_top = NodePath("../../../../ReturnTitle")
custom_minimum_size = Vector2(172, 232)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
focus_neighbor_left = NodePath("../Stage5")
focus_neighbor_right = NodePath("../Stage6")
focus_neighbor_bottom = NodePath("../../Preview")
text = "ステージ 6\n\n追跡者の終域\n\nプレイする"

[node name="Preview" type="Button" parent="Margin/Content"]
custom_minimum_size = Vector2(0, 42)
layout_mode = 2
focus_neighbor_top = NodePath("../Stages/Stage1")
focus_neighbor_bottom = NodePath("../../../ReturnTitle")
text = "5つの環境を見る — 背景とギミックのプレビュー"

[node name="Availability" type="Label" parent="Margin/Content"]
layout_mode = 2
text = "ステージ1〜6は、クリア状況に関係なく自由に選べます。"

[node name="Controls" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.73, 0.88, 1)
theme_override_font_sizes/font_size = 18
text = "選択：方向キー / 十字キー / スティック　　決定：Enter / A・×　　マウスでも選べます"

[node name="ReturnTitle" type="Button" parent="."]
layout_mode = 1
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -290.0
offset_top = 48.0
offset_right = -64.0
offset_bottom = 122.0
grow_horizontal = 0
focus_neighbor_top = NodePath("../Margin/Content/Preview")
focus_neighbor_bottom = NodePath("../Margin/Content/Stages/Stage1")
text = "タイトルに戻る"

[connection signal="pressed" from="ReturnTitle" to="." method="_return_to_title"]

[connection signal="pressed" from="Margin/Content/Stages/Stage1" to="." method="_start_tutorial"]

[connection signal="pressed" from="Margin/Content/Stages/Stage2" to="." method="_start_stage_two"]

[connection signal="pressed" from="Margin/Content/Preview" to="." method="_preview_environments"]

[connection signal="pressed" from="Margin/Content/Stages/Stage3" to="." method="_start_stage_three"]

[connection signal="pressed" from="Margin/Content/Stages/Stage4" to="." method="_start_stage_four"]

[connection signal="pressed" from="Margin/Content/Stages/Stage5" to="." method="_start_stage_five"]

[connection signal="pressed" from="Margin/Content/Stages/Stage6" to="." method="_start_stage_six"]
