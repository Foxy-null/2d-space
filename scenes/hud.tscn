[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/hud.gd" id="1_hud"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="Margin" type="MarginContainer" parent="."]
offset_right = 1280.0
offset_bottom = 720.0
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 20

[node name="Panel" type="PanelContainer" parent="Margin"]
layout_mode = 2
size_flags_horizontal = 0
size_flags_vertical = 0

[node name="Rows" type="VBoxContainer" parent="Margin/Panel"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="Margin/Panel/Rows"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "2D SPACE — BASE SYSTEM"

[node name="Controls" type="Label" parent="Margin/Panel/Rows"]
layout_mode = 2
text = "MOVE: A/D or arrows / Stick/D-pad   JUMP: Space/W/Up or A/×"

[node name="WallControls" type="Label" parent="Margin/Panel/Rows"]
layout_mode = 2
text = "GRAB: Shift/ZR   CLIMB: Up/Down   RESET: R/Start"

[node name="Gravity" type="Label" parent="Margin/Panel/Rows"]
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 0.95, 1, 1)
text = "GRAVITY: DOWN"
