[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/stage_help.gd" id="help"]

[sub_resource type="StyleBoxFlat" id="Panel"]
bg_color = Color(0.078, 0.141, 0.231, 0.98)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.435, 0.624, 0.729, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_left = 12
corner_radius_bottom_right = 12
content_margin_left = 24.0
content_margin_top = 16.0
content_margin_right = 24.0
content_margin_bottom = 16.0

[node name="Help" type="PanelContainer"]
process_mode = 3
visible = false
offset_left = 160.0
offset_top = 90.0
offset_right = 1120.0
offset_bottom = 630.0
theme_override_styles/panel = SubResource("Panel")
script = ExtResource("help")

[node name="Rows" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Rows"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "お助けメニュー"
autowrap_mode = 3

[node name="Columns" type="HBoxContainer" parent="Rows"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 24

[node name="HintScroll" type="ScrollContainer" parent="Rows/Columns"]
custom_minimum_size = Vector2(580, 280)
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 2
focus_neighbor_bottom = NodePath("../../Hints")
focus_neighbor_right = NodePath("../../Actions/Resume")
horizontal_scroll_mode = 0

[node name="Hint" type="Label" parent="Rows/Columns/HintScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.88, 0.95, 1, 1)
theme_override_font_sizes/font_size = 20
theme_override_constants/line_spacing = 6
autowrap_mode = 3

[node name="Controls" type="Label" parent="Rows/Columns"]
custom_minimum_size = Vector2(270, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0.68, 0.83, 0.92, 1)
theme_override_font_sizes/font_size = 16
text = "基本操作\n移動：WASD / 方向キー\nジャンプ：Space / A・×\nダッシュ：X / B・○\n掴む：Shift / ZL・ZR\n壁登り：掴んで方向入力\n置く：止まって掴むを離す\n投げる：動いて掴むを離す\nR / Start：やり直す\nヒント欄は↑↓で読む\n→でボタンへ戻れます"
autowrap_mode = 3

[node name="Hints" type="CheckButton" parent="Rows"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "コース上のヒントも表示する"
focus_neighbor_bottom = NodePath("../Actions/Resume")

[node name="Actions" type="HBoxContainer" parent="Rows"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Resume" type="Button" parent="Rows/Actions"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 18
text = "プレイを再開する"
focus_neighbor_top = NodePath("../../Columns/HintScroll")

[node name="Retry" type="Button" parent="Rows/Actions"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 18
text = "この部屋をやり直す"

[node name="Return" type="Button" parent="Rows/Actions"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 18
text = "ステージ選択へ戻る"

[node name="CloseHint" type="Label" parent="Rows"]
layout_mode = 2
theme_override_colors/font_color = Color(0.68, 0.83, 0.92, 1)
theme_override_font_sizes/font_size = 16
text = "H / Y・△、Esc / Backで閉じる　｜　表示中はゲームを一時停止"
