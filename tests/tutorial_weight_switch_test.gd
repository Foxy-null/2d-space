extends "res://tests/tutorial_extension_test.gd"


func _run() -> void:
	tutorial = load("res://scenes/tutorial.tscn").instantiate()
	root.add_child(tutorial)
	player = tutorial.player
	await _step(5)
	await _enter(10)
	_check(tutorial.STEPS[10] == ["button_on"], "The puzzle asks for the physical switch, without unrelated chores")
	_check(_room().get_node("Goal").locked, "The arrival switch starts locked")
	await _grab("SmallBox")
	Input.action_release("move_right")
	await _step(12)
	Input.action_release("wall_grab")
	await _step(20)
	await _grab("Heavy")
	await _place_box()
	var button = _room().get_node("Button")
	var goal = _room().get_node("Goal")
	var link = _room().get_node("ButtonLink")
	_check(button.is_pressed() and not goal.locked, "A real placed box unlocks the arrival switch")
	_check(link.default_color == Color("86e7a4"), "The physical connection shows the powered state")
	await _grab("Heavy")
	await _step(5)
	_check(not button.is_pressed() and goal.locked and not tutorial.seen.has("button_on"), "Lifting the box relocks the switch before clearing")
	_check(link.default_color == Color("56718d"), "The connection returns to its unpowered state")
	await _place_box()
	_check(button.is_pressed() and not goal.locked, "Replacing the box restores the real powered state")
	await _walk_goal()
	_check(tutorial.cleared.has(10), "Placing one box and reaching the target completes the puzzle")
	player.respawn()
	await _step(5)
	_check(tutorial.cleared.has(10) and _room().get_node("ExitBarrier/Collision").disabled, "A completed puzzle stays open after retry")
	tutorial.cleared.erase(10)
	await _enter(10)
	_check(not _room().get_node("Button").is_pressed() and _room().get_node("Goal").locked, "A fresh attempt resets objects and the lock")
	await _grab("SmallBox")
	await _walk_to(290)
	await _pulse("jump")
	await _place_box()
	_check(_room().get_node("Button").overlaps_body(_room().get_node("SmallBox")) and not _room().get_node("Goal").locked, "The light box can also physically power the switch")
	Input.action_press("reset")
	await _step()
	Input.action_release("reset")
	await _step(5)
	_check(_room().get_node("Goal").locked and not tutorial.seen.has("button_on"), "Retry clears the unfinished switch state")
	_release()
	print("TUTORIAL_WEIGHT_SWITCH_TEST_%s (%d checks)" % ["FAILED" if failed else "OK", checks])
	tutorial.queue_free()
	await _step(3)
	quit(1 if failed else 0)


func _place_box() -> void:
	await _walk_to(745)
	Input.action_release("move_right")
	await _step(12)
	Input.action_release("wall_grab")
	Input.action_press("move_left")
	await _step(18)
	Input.action_release("move_left")
	await _step(45)
